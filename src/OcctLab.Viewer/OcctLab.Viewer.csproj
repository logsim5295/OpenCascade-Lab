<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>OcctLab.Viewer</RootNamespace>
    <AssemblyName>OcctLab.Viewer</AssemblyName>
    <!-- WinForms 컨트롤을 호스팅하는 WPF 창: OCCT의 OpenGL 뷰에는 실제 HWND가 필요하다 -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF와 WinForms 모두 암시적 using을 추가하므로, WPF 것만 전역으로 두고 WinForms는 명시적으로 import한다 -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OcctLab.Runtime\OcctLab.Runtime.csproj" />
    <ProjectReference Include="..\OcctProxy\OcctProxy.vcxproj" />
  </ItemGroup>

</Project>

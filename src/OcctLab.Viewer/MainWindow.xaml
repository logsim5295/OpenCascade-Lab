<Window x:Class="OcctLab.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="OCCT Lab Viewer" Width="1100" Height="750" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Header="Model" Band="0" BandIndex="0">
                <Button Content="Box" Click="OnBox" ToolTip="100 x 60 x 40 box"/>
                <Button Content="Box2" Click="OnBox2" ToolTip="한 모서리가 (x, y, z)에 있는 박스"/>
                <Button Content="Cylinder" Click="OnCylinder"/>
                <Button Content="Sphere" Click="OnSphere"/>
                <Button Content="Torus" Click="OnTorus"/>
                <Separator/>
                <Button Content="Demo (Cut + Fillet)" Click="OnDemo" FontWeight="Bold"/>
            </ToolBar>
            <ToolBar Header="File" Band="0" BandIndex="1">
                <Button Content="Import..." Click="OnImport" ToolTip="STEP / IGES / BREP"/>
                <Button Content="Export STEP..." Click="OnExportStep"/>
                <Button Content="Screenshot..." Click="OnScreenshot"/>
            </ToolBar>
            <ToolBar Header="View" Band="1" BandIndex="0">
                <Button Content="Fit All" Click="OnFitAll"/>
                <Button Content="Wireframe" Click="OnWireframe"/>
                <Button Content="Shaded" Click="OnShaded"/>
                <Separator/>
                <Button Content="Iso" Click="OnIso"/>
                <Button Content="Front" Click="OnFront"/>
                <Button Content="Top" Click="OnTop"/>
                <Button Content="Right" Click="OnRight"/>
            </ToolBar>
            <ToolBar Header="Edit" Band="1" BandIndex="1">
                <Button Content="Color Selected" Click="OnColorSelected"/>
                <Button Content="Delete Selected" Click="OnDeleteSelected"/>
                <Button Content="Clear" Click="OnClear"/>
            </ToolBar>
            <ToolBar Header="Move" Band="2" BandIndex="0">
                <Button Name="btnMovePlusX" Content="X축 + 이동" Click="OnMoveSelected"/>
                <Button Name="btnMovePlusY" Content="Y축 + 이동" Click="OnMoveSelected"/>
                <Button Name="btnMovePlusZ" Content="Z축 + 이동" Click="OnMoveSelected"/>
                <Button Name="btnMoveMinusX" Content="X축 - 이동" Click="OnMoveSelected"/>
                <Button Name="btnMoveMinusY" Content="Y축 - 이동" Click="OnMoveSelected"/>
                <Button Name="btnMoveMinusZ" Content="Z축 - 이동" Click="OnMoveSelected"/>
            </ToolBar>
            <ToolBar Header="Rotate" Band="2" BandIndex="1">
                <Button Name="btnRotatePlusX" Content="X축 + 회전" Click="OnRotateSelected"/>
                <Button Name="btnRotatePlusY" Content="Y축 + 회전" Click="OnRotateSelected"/>
                <Button Name="btnRotatePlusZ" Content="Z축 + 회전" Click="OnRotateSelected"/>
                <Button Name="btnRotateMinusX" Content="X축 - 회전" Click="OnRotateSelected"/>
                <Button Name="btnRotateMinusY" Content="Y축 - 회전" Click="OnRotateSelected"/>
                <Button Name="btnRotateMinusZ" Content="Z축 - 회전" Click="OnRotateSelected"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="VersionText"/>
            </StatusBarItem>
        </StatusBar>

        <!-- WinForms 호스트: OCCT가 자식 컨트롤의 HWND에 OpenGL로 직접 렌더링한다 -->
        <wf:WindowsFormsHost x:Name="ViewHost"/>
    </DockPanel>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    네이티브 OCCT DLL의 위치를 프로세스에 알려 주는 작은 헬퍼 라이브러리.
    경로는 Directory.Build.props에서 빌드 시점에 구워 넣으므로, 약 1 GB에 달하는
    OCCT / 서드파티 DLL을 출력 폴더마다 복사하지 않아도 Visual Studio의 F5와
    탐색기에서 exe 실행 모두 동작한다.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OcctLab.Runtime</RootNamespace>
    <AssemblyName>OcctLab.Runtime</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="OcctRoot" Value="$(OcctRoot)" />
    <AssemblyMetadata Include="OcctRuntimeDirs" Value="$(OcctRuntimeDirs)" />
    <AssemblyMetadata Include="OcctConfiguration" Value="$(Configuration)" />
  </ItemGroup>

</Project>
